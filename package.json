{
  "name": "assethub-backend",
  "version": "1.0.0",
  "description": "AssetHub backend API with Prisma, JWT auth, CRUD, and spreadsheet import support.",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "swagger": "node scripts/swagger.js",
    "docs:pdf": "node scripts/generate-api-pdf.js",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "test": "jest --runInBand",
    "test:server": "node scripts/test-server.js",
    "test:acceptance": "jest --runInBand tests/acceptance",
    "test:cov": "jest --runInBand --coverage"
  },
  "keywords": [
    "assethub",
    "express",
    "prisma",
    "asset-management",
    "xlsx"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "file-type": "^22.1.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prisma": "^5.10.0",
    "supertest": "^7.1.4"
  }
}
